# Local development only. Never commit this file.
# Copy of .env.example with local Firebase Admin path (file stays outside the repo).

APP_ENV=development
APP_NAME=BoomBoom API
APP_HOST=0.0.0.0
APP_PORT=8080

DATABASE_URL=postgresql+asyncpg://boomboom:boomboom_dev_only@localhost:5432/boomboom
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-a-long-random-local-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

OTP_EXPIRE_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=4

LOG_LEVEL=INFO

# Host path only — never the JSON document.
# Native API/worker (uvicorn / python -m): Windows path.
FIREBASE_CREDENTIALS_JSON=C:/Users/Dolly Nagrani/firebase-secrets/boomboom-firebase-admin.json
# Compose bind-mount source. Set this after the Admin JSON file exists on disk.
# Until then, compose mounts docker/firebase-credentials.placeholder (Noop).
FIREBASE_CREDENTIALS_FILE=C:/Users/Dolly Nagrani/firebase-secrets/boomboom-firebase-admin.json
FIREBASE_PROJECT_ID=boomboom-7712a

SUBSCRIPTION_VERIFY_MODE=mock
GOOGLE_PLAY_PACKAGE_NAME=com.boomboomapp.date
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PLAY_WEBHOOK_SECRET=
GOOGLE_PUBSUB_PROJECT=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
APPLE_BUNDLE_ID=com.boomboom.app
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_WEBHOOK_SECRET=
APPLE_IAP_EXPECTED_ENVIRONMENT=auto

PUBLIC_APP_ORIGIN=https://boomboom.app
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=
