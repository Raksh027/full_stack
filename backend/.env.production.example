# Production environment — copy to .env.production on the VPS.
# NEVER commit this file with real secrets.
# All values here are REQUIRED for a working production deployment.
#
# Generate a strong JWT secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Generate a strong Postgres password:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=BoomBoom API
APP_HOST=0.0.0.0
APP_PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
# Used by docker-compose.prod.yml to build the full DATABASE_URL.
# POSTGRES_USER and POSTGRES_PASSWORD are injected into DATABASE_URL at runtime.
POSTGRES_USER=boomboom_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Full async URL (overrides the env vars above for the FastAPI process).
DATABASE_URL=postgresql+asyncpg://boomboom_prod:CHANGE_ME_strong_password_here@postgres:5432/boomboom_production
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# MUST be at least 32 characters. Never use "replace-with" in production.
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed browser origins.
# Flutter mobile apps do NOT send Origin headers, so they are not restricted.
# Add the admin panel domain if you have one.
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# ─── OTP / Email ──────────────────────────────────────────────────────────────
OTP_EXPIRE_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=4

# Gmail App Password (never your real Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=BoomBoom

LOG_LEVEL=INFO

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Host filesystem path to the Admin SDK JSON.
# docker-compose.prod.yml mounts this at /run/secrets/firebase-admin.json.
# FIREBASE_CREDENTIALS_JSON is set by compose from the mount path.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_FILE=/etc/boomboom/firebase-admin.json

# ─── Billing ──────────────────────────────────────────────────────────────────
# MUST be "live" in production. "mock" is not allowed.
SUBSCRIPTION_VERIFY_MODE=live

GOOGLE_PLAY_PACKAGE_NAME=com.boomboomapp.date
# Paste the service-account JSON on the VPS only (one line). Compose does not
# mount a Play credential file. A host path is only valid if that file is
# visible inside the api and worker containers.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PLAY_WEBHOOK_SECRET=your-google-play-webhook-secret
GOOGLE_PUBSUB_PROJECT=your-gcp-project-id
GOOGLE_PUBSUB_TOPIC=play-rtdn
GOOGLE_PUBSUB_SUBSCRIPTION=projects/your-gcp-project-id/subscriptions/play-rtdn-push

APPLE_BUNDLE_ID=com.boomboom
APPLE_IAP_ISSUER_ID=your-apple-issuer-id
APPLE_IAP_KEY_ID=your-apple-key-id
APPLE_IAP_PRIVATE_KEY=your-apple-p8-private-key-content
APPLE_IAP_WEBHOOK_SECRET=
# Must be "Production" or "auto" (auto selects Production when APP_ENV=production).
APPLE_IAP_EXPECTED_ENVIRONMENT=Production

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Social Login ─────────────────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ─── Links ────────────────────────────────────────────────────────────────────
# Canonical public origin for Event share pages and Universal Links.
PUBLIC_APP_ORIGIN=https://your-domain.com
APPLE_TEAM_ID=your-apple-team-id
# Comma-separated SHA-256 fingerprints for Android Digital Asset Links.
ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...

# ─── Media Storage ────────────────────────────────────────────────────────────
MEDIA_STORAGE_PATH=/app/storage/uploads
# Public-facing base URL for serving uploaded media files.
# Example: https://your-domain.com/api/v1/media/files
MEDIA_PUBLIC_BASE_URL=https://your-domain.com/api/v1/media/files
MEDIA_MAX_BYTES=8000000
MEDIA_MAX_ITEMS=6
MEDIA_UPLOAD_EXPIRE_SECONDS=900
