# ─── Environment / secrets ────────────────────────────────────────────────────
# .env.example is safe to track (no real values). Everything else must stay off git.
.env
.env.production
.env.staging
.env.local
.env.*.local

# Android release signing — key.properties.example IS tracked (it has no real values).
android/key.properties

# Google Maps / Firebase / Play service-account keys must never be committed
**/google-services.json.bak
**/GoogleService-Info.plist.bak
