# Copy to .env for local development. Never commit real secrets.
# Staging/production values must come from the host/orchestrator.

APP_ENV=development
APP_NAME=BoomBoom API
APP_HOST=0.0.0.0
APP_PORT=8080

# Async SQLAlchemy URL (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://boomboom:boomboom_dev_only@localhost:5432/boomboom
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

# Generate a unique secret per environment. Minimum 32 characters.
JWT_SECRET=replace-with-a-long-random-local-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated origins. Empty = no browser origins (non-browser clients still work).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

OTP_EXPIRE_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=4

LOG_LEVEL=INFO

# Firebase Admin (backend only). Never put this in Flutter.
# Preferred: filesystem path to the Admin SDK JSON. Leave empty for NoopPushProvider
# (inbox/jobs still work; no FCM is sent). Do not paste the JSON document here.
# Native local process example (Windows):
# FIREBASE_CREDENTIALS_JSON=C:\Users\YOU\firebase-secrets\boomboom-firebase-admin.json
# Docker Compose uses FIREBASE_CREDENTIALS_FILE (host path) and mounts it at
# /run/secrets/firebase-admin.json inside api and worker.
# On Windows, use forward slashes so Compose does not treat \b \f \U as escapes:
# FIREBASE_CREDENTIALS_FILE=C:/Users/YOU/firebase-secrets/boomboom-firebase-admin.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=your-firebase-project-id

# Billing. Flutter never receives these values.
# mock = local tests only. Staging and production refuse mock.
SUBSCRIPTION_VERIFY_MODE=mock
GOOGLE_PLAY_PACKAGE_NAME=com.boomboomapp.date
# Inline JSON document OR leave empty and use a file path below. Never commit the key.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# File path or secret-store mount (preferred in staging). Not a private key.
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PLAY_WEBHOOK_SECRET=
# Pub/Sub identity for RTDN. Example: my-gcp-project / play-rtdn / projects/my-gcp-project/subscriptions/play-rtdn-push
GOOGLE_PUBSUB_PROJECT=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
APPLE_BUNDLE_ID=com.boomboom.app
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
# Optional extra header for local mock posts. Live Apple authenticity is JWS + x5c.
APPLE_IAP_WEBHOOK_SECRET=
# auto | Sandbox | Production. auto = Production only when APP_ENV=production.
APPLE_IAP_EXPECTED_ENVIRONMENT=auto

# Canonical public origin for Event share / Universal Links (not the API host).
PUBLIC_APP_ORIGIN=https://boomboom.app
APPLE_TEAM_ID=
# Comma-separated Play signing-cert SHA-256 fingerprints for Digital Asset Links.
ANDROID_SHA256_CERT_FINGERPRINTS=
