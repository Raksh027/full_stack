# Staging placeholders only. Copy to a host-managed secret file (not git).
# Real keys stay in the secret manager / volume mount.

APP_ENV=staging
APP_NAME=BoomBoom API
APP_HOST=0.0.0.0
APP_PORT=8080

# Must be a staging database, not boomboom_dev_only / local defaults.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@postgres:5432/boomboom_staging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-a-unique-staging-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=

LOG_LEVEL=INFO

# Firebase Admin (API + worker). Placeholders only — never commit the JSON.
# Mount the host file via FIREBASE_CREDENTIALS_FILE; the process reads the
# in-container path below. Empty credentials keep NoopPushProvider.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_JSON=/run/secrets/firebase-admin.json
FIREBASE_CREDENTIALS_FILE=

SUBSCRIPTION_VERIFY_MODE=live
GOOGLE_PLAY_PACKAGE_NAME=com.boomboomapp.date
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT=/run/secrets/google-play-service-account.json
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PLAY_WEBHOOK_SECRET=
GOOGLE_PUBSUB_PROJECT=
GOOGLE_PUBSUB_TOPIC=play-rtdn
GOOGLE_PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT/subscriptions/play-rtdn-push
